# Multi-Agent SOC Analyst Configuration

# Triage & Agent Execution Mode: rules | llm | system1 | hybrid
TRIAGE_MODE=hybrid
ORCHESTRATOR_TYPE=langgraph

# OpenAI-Compatible API Configuration
# Compatible with OpenAI, OpenRouter, DeepSeek, Ollama, vLLM, LMStudio, etc.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Fast Embedding / RAG Configuration
# Local lightweight model (e.g. all-MiniLM-L6-v2) or OpenAI-compatible embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# System 1 Fast Decision Model (<500MB local model)
# E.g. local quantized/ONNX model or fine-tuned DistilBERT / SetFit / Small SLM
SYSTEM1_MODEL_PATH=locals/models/system1_triage_classifier
SYSTEM1_CONFIDENCE_THRESHOLD=0.85

# External Threat Intelligence APIs (Optional - defaults to offline replay / local mocks)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=

# Storage & Logging (Kept in ignored locals/ folder)
LOCAL_DATA_DIR=locals/data
LOCAL_LOGS_DIR=locals/logs
BENCHMARK_OUTPUT_DIR=locals/benchmarks
